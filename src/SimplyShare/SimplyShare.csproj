<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>SimplyShare</RootNamespace>
    <AssemblyName>SimplyShare</AssemblyName>
    <Version>1.0.65</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <!-- 배포: NativeAOT + Size 최적화 -->
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>true</PublishTrimmed>
    <StripSymbols>true</StripSymbols>
    <OptimizationPreference>Size</OptimizationPreference>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- JSON Source Generator (리플렉션 최소화) -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <!-- DI -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Duxel\src\Duxel.Windows.App\Duxel.Windows.App.csproj" />
    <ProjectReference Include="..\..\..\Duxel\src\Duxel.Core\Duxel.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\app.ico" LogicalName="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="App.xaml.cs" />
    <Compile Remove="AssemblyInfo.cs" />
    <Compile Remove="GlobalUsings.cs" />
    <Compile Remove="MainWindow.xaml.cs" />
    <Compile Remove="Converters\**\*.cs" />
    <Compile Remove="Core\Clipboard\ClipboardWatcher.cs" />
    <Compile Remove="Services\NotificationService.cs" />
    <Compile Remove="ViewModels\**\*.cs" />
    <Compile Remove="Views\**\*.cs" />
  </ItemGroup>

</Project>










































