<Window x:Class="SimplyShare.Views.TextViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="텍스트 보기" Height="400" Width="500"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/app.ico">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBox x:Name="ContentBox"
                 IsReadOnly="True" 
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontSize="13" Padding="8"
                 BorderBrush="#DDD" BorderThickness="1"/>
        
        <StackPanel Grid.Row="1" Orientation="Horizontal" 
                    HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="전체 선택" Padding="16,6" Margin="0,0,8,0"
                    Click="SelectAllButton_Click"/>
            <Button Content="복사" Padding="16,6" Margin="0,0,8,0"
                    Click="CopyButton_Click"/>
            <Button Content="닫기" Padding="16,6" 
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
