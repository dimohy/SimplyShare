<Window x:Class="SimplyShare.Views.TransferDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="전송 요청" 
        SizeToContent="WidthAndHeight"
        MinWidth="350"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="SenderText" FontSize="14" FontWeight="Bold"/>
        <TextBlock Grid.Row="2" x:Name="ContentText" TextWrapping="Wrap" MaxWidth="400"/>
        <TextBlock Grid.Row="4" x:Name="SizeText" Foreground="Gray" FontSize="11"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="거부" Width="80" Padding="4,6" 
                    Click="RejectButton_Click" Margin="0,0,8,0"/>
            <Button Content="수락" Width="80" Padding="4,6" 
                    Click="AcceptButton_Click" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
